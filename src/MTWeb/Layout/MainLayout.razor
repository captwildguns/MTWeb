@inherits LayoutComponentBase

<StxAppLayout AppTitle="MT Web"
              AppTitleHref="/"
              NavGroups="@_navGroups"
              AppBarButtons="@_appBarButtons"
              UseMiniDrawer="false"
              AllowMiniHoverExpand="false">
    <AppBarLogo>
        <forge-icon name="@ForgeIcons.DirectionsBus.GetDisplayName()"></forge-icon>
    </AppBarLogo>
    <ChildContent>
        <main id="main-content" class="p-medium">
            @Body
        </main>
    </ChildContent>
</StxAppLayout>

@code {
    private readonly IReadOnlyList<StxNavGroup> _navGroups =
    [
        new()
        {
            Label = "Tyler Drive",
            Icon  = ForgeIcons.PhoneAndroid,
            Items =
            [
                new() { Text = "Home",        Href = "tyler-drive/home",        Icon = ForgeIcons.Home },
                new() { Text = "Setup",       Href = "tyler-drive/setup",       Icon = ForgeIcons.Settings },
                new() { Text = "Messaging",   Href = "tyler-drive/messaging",   Icon = ForgeIcons.ChatBubble },
                new() { Text = "Break Time",  Href = "tyler-drive/break-time",  Icon = ForgeIcons.Timer },
                new() { Text = "Timekeeping", Href = "tyler-drive/timekeeping", Icon = ForgeIcons.AccessTime },
                new() { Text = "Inspections", Href = "tyler-drive/inspections", Icon = ForgeIcons.CheckCircle },
                new() { Text = "Reports",     Href = "tyler-drive/reports",     Icon = ForgeIcons.BarChart },
            ]
        }
    ];

    private readonly IReadOnlyList<StxAppBarButton> _appBarButtons =
    [
        StxAppBarButtons.Help(),
        StxAppBarButtons.Profile(name: "MT User", email: "user@tylertech.com", avatarText: "MT")
    ];
}
