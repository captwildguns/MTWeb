<ForgeForm @ref="_form" Model="_model">
    <div class="field-row"><label>My Runs</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.MyRunsEnabled)" ValueChanged="@((string v)=>_model.MyRunsEnabled=v=="Enabled")" RadioValue="Enabled" Name="myRuns">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.MyRunsEnabled)" ValueChanged="@((string v)=>_model.MyRunsEnabled=v=="Enabled")" RadioValue="Disabled" Name="myRuns">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Navigation</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.NavigationEnabled)" ValueChanged="@((string v)=>_model.NavigationEnabled=v=="Enabled")" RadioValue="Enabled" Name="nav">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.NavigationEnabled)" ValueChanged="@((string v)=>_model.NavigationEnabled=v=="Enabled")" RadioValue="Disabled" Name="nav">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Show Next Stop Eta</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.ShowNextStopEta)" ValueChanged="@((string v)=>_model.ShowNextStopEta=v=="Enabled")" RadioValue="Enabled" Name="eta">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.ShowNextStopEta)" ValueChanged="@((string v)=>_model.ShowNextStopEta=v=="Enabled")" RadioValue="Disabled" Name="eta">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Allow Trips</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.AllowTrips)" ValueChanged="@((string v)=>_model.AllowTrips=v=="Enabled")" RadioValue="Enabled" Name="trips">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.AllowTrips)" ValueChanged="@((string v)=>_model.AllowTrips=v=="Enabled")" RadioValue="Disabled" Name="trips">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent2"><label>Capture Trip Completion Data</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.CaptureTripCompletionData)" ValueChanged="@((string v)=>_model.CaptureTripCompletionData=v=="Enabled")" RadioValue="Enabled" Name="tripData">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.CaptureTripCompletionData)" ValueChanged="@((string v)=>_model.CaptureTripCompletionData=v=="Enabled")" RadioValue="Disabled" Name="tripData">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Require End of Run Signature</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.RequireEndOfRunSignature)" ValueChanged="@((string v)=>_model.RequireEndOfRunSignature=v=="Enabled")" RadioValue="Enabled" Name="sig">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.RequireEndOfRunSignature)" ValueChanged="@((string v)=>_model.RequireEndOfRunSignature=v=="Enabled")" RadioValue="Disabled" Name="sig">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Auto Rollout</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.AutoRolloutEnabled)" ValueChanged="@((string v)=>_model.AutoRolloutEnabled=v=="Enabled")" RadioValue="Enabled" Name="rollout">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.AutoRolloutEnabled)" ValueChanged="@((string v)=>_model.AutoRolloutEnabled=v=="Enabled")" RadioValue="Disabled" Name="rollout">Disabled</ForgeRadio></span></div>
    @if (_model.AutoRolloutEnabled) { <div class="field-note field-row-indent2">By enabling Auto Rollout for Tyler Drive, existing forms of auto rollout will be disabled.</div> }
    <div class="field-row"><label>Add Run Search Type</label><ForgeSelect @bind-Value="_model.AddRunSearchType" FloatLabelType="FloatLabelType.Never" style="width:160px"><ForgeSelectOption Value="@("Both")">Both</ForgeSelectOption><ForgeSelectOption Value="@("ByName")">By Name</ForgeSelectOption><ForgeSelectOption Value="@("ByNumber")">By Number</ForgeSelectOption></ForgeSelect></div>
    <div class="field-row"><label>AVL</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.AvlEnabled)" ValueChanged="@((string v)=>_model.AvlEnabled=v=="Enabled")" RadioValue="Enabled" Name="avl">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.AvlEnabled)" ValueChanged="@((string v)=>_model.AvlEnabled=v=="Enabled")" RadioValue="Disabled" Name="avl">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Events Only</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.AvlEventsOnly)" ValueChanged="@((string v)=>_model.AvlEventsOnly=v=="Enabled")" RadioValue="Enabled" Name="avlEvt">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.AvlEventsOnly)" ValueChanged="@((string v)=>_model.AvlEventsOnly=v=="Enabled")" RadioValue="Disabled" Name="avlEvt">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>AVL Stop Event Interval</label><span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.AvlStopEventIntervalSeconds" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" /><span>seconds</span></span></div>
    <div class="field-row field-row-indent"><label>Speeding Buffer</label><span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.SpeedingBufferMph" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" /><span>mile(s) per hour</span></span></div>
    <div class="field-row field-row-indent"><label>Late Alert Threshold</label><span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.LateAlertThresholdMinutes" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" /><span>minutes</span></span></div>
    <div class="field-row field-row-indent"><label>Early Alert Threshold</label><span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.EarlyAlertThresholdMinutes" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" /><span>minutes</span></span></div>
    <div class="field-row"><label>Modify Stops</label></div>
    <div class="field-row field-row-indent"><label>Require Planned Route</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.ModifyStopsRequirePlannedRoute)" ValueChanged="@((string v)=>_model.ModifyStopsRequirePlannedRoute=v=="Enabled")" RadioValue="Enabled" Name="msPR">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.ModifyStopsRequirePlannedRoute)" ValueChanged="@((string v)=>_model.ModifyStopsRequirePlannedRoute=v=="Enabled")" RadioValue="Disabled" Name="msPR">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Allow During Navigation</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.ModifyStopsAllowDuringNavigation)" ValueChanged="@((string v)=>_model.ModifyStopsAllowDuringNavigation=v=="Enabled")" RadioValue="Enabled" Name="msAN">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.ModifyStopsAllowDuringNavigation)" ValueChanged="@((string v)=>_model.ModifyStopsAllowDuringNavigation=v=="Enabled")" RadioValue="Disabled" Name="msAN">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Enable Add By Address</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.ModifyStopsEnableAddByAddress)" ValueChanged="@((string v)=>_model.ModifyStopsEnableAddByAddress=v=="Enabled")" RadioValue="Enabled" Name="msAA">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.ModifyStopsEnableAddByAddress)" ValueChanged="@((string v)=>_model.ModifyStopsEnableAddByAddress=v=="Enabled")" RadioValue="Disabled" Name="msAA">Disabled</ForgeRadio></span></div>
    <div class="field-row"><label>Additional Stop Buffer</label></div>
    <div class="field-row field-row-indent"><label>All Stops</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.AdditionalStopBufferAllStops)" ValueChanged="@((string v)=>_model.AdditionalStopBufferAllStops=v=="Enabled")" RadioValue="Enabled" Name="asbAll">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.AdditionalStopBufferAllStops)" ValueChanged="@((string v)=>_model.AdditionalStopBufferAllStops=v=="Enabled")" RadioValue="Disabled" Name="asbAll">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Before Stop</label><span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.AdditionalStopBufferBeforeFeet" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" /><span>feet</span></span></div>
    <div class="field-row field-row-indent"><label>After Stop</label><span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.AdditionalStopBufferAfterFeet" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" /><span>feet</span></span></div>
    <div class="field-row field-row-indent"><label>From Road</label><span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.AdditionalStopBufferFromRoadFeet" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" /><span>feet</span></span></div>
    <div class="field-row"><label>Enable ETA System Notifications</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.EnableEtaSystemNotifications)" ValueChanged="@((string v)=>_model.EnableEtaSystemNotifications=v=="Enabled")" RadioValue="Enabled" Name="etaSys">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.EnableEtaSystemNotifications)" ValueChanged="@((string v)=>_model.EnableEtaSystemNotifications=v=="Enabled")" RadioValue="Disabled" Name="etaSys">Disabled</ForgeRadio></span></div>
    <div class="field-note">ETA System Notifications are required for other parts of the system to work, such as My Ride K-12 ETA Notifications and Arrival Board</div>
    <div class="setup-actions"><StxButton Intent="StxButtonIntent.Save" OnClick="HandleSave" /></div>
</ForgeForm>
@code {
    private readonly NavigationSetupModel _model = new();
    private ForgeForm? _form;
    private static string ED(bool v) => v ? "Enabled" : "Disabled";
    private async Task HandleSave() { await Task.CompletedTask; }
}
