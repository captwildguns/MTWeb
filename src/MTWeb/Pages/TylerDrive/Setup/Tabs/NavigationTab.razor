<ForgeForm @ref="_form" Model="_model">
    <div class="field-row"><label>My Runs</label><ForgeRadioGroup @bind-Value="_model.MyRunsEnabled"><ForgeRadio Value="@true">Enabled</ForgeRadio><ForgeRadio Value="@false">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Navigation</label><ForgeRadioGroup @bind-Value="_model.NavigationEnabled"><ForgeRadio Value="@true">Enabled</ForgeRadio><ForgeRadio Value="@false">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Show Next Stop Eta</label><ForgeRadioGroup @bind-Value="_model.ShowNextStopEta"><ForgeRadio Value="@true">Enabled</ForgeRadio><ForgeRadio Value="@false">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Allow Trips</label><ForgeRadioGroup @bind-Value="_model.AllowTrips"><ForgeRadio Value="@true">Enabled</ForgeRadio><ForgeRadio Value="@false">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent2"><label>Capture Trip Completion Data</label><ForgeRadioGroup @bind-Value="_model.CaptureTripCompletionData"><ForgeRadio Value="@true">Enabled</ForgeRadio><ForgeRadio Value="@false">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Require End of Run Signature</label><ForgeRadioGroup @bind-Value="_model.RequireEndOfRunSignature"><ForgeRadio Value="@true">Enabled</ForgeRadio><ForgeRadio Value="@false">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Auto Rollout</label><ForgeRadioGroup @bind-Value="_model.AutoRolloutEnabled"><ForgeRadio Value="@true">Enabled</ForgeRadio><ForgeRadio Value="@false">Disabled</ForgeRadio></ForgeRadioGroup></div>
    @if (_model.AutoRolloutEnabled) { <div class="field-note field-row-indent2">By enabling Auto Rollout for Tyler Drive, existing forms of auto rollout will be disabled.</div> }

    <div class="field-row">
        <label>Add Run Search Type</label>
        <ForgeSelect @bind-Value="_model.AddRunSearchType" FloatLabelType="FloatLabelType.Never" style="width:160px">
            <ForgeSelectOption Value="@("Both")">Both</ForgeSelectOption>
            <ForgeSelectOption Value="@("ByName")">By Name</ForgeSelectOption>
            <ForgeSelectOption Value="@("ByNumber")">By Number</ForgeSelectOption>
        </ForgeSelect>
    </div>

    <div class="field-row"><label>AVL</label><ForgeRadioGroup @bind-Value="_model.AvlEnabled"><ForgeRadio Value="@true">Enabled</ForgeRadio><ForgeRadio Value="@false">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Events Only</label><ForgeRadioGroup @bind-Value="_model.AvlEventsOnly"><ForgeRadio Value="@true">Enabled</ForgeRadio><ForgeRadio Value="@false">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>AVL Stop Event Interval</label><span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.AvlStopEventIntervalSeconds" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" /><span>seconds</span></span></div>
    <div class="field-row field-row-indent"><label>Speeding Buffer</label><span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.SpeedingBufferMph" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" /><span>mile(s) per hour</span></span></div>
    <div class="field-row field-row-indent"><label>Late Alert Threshold</label><span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.LateAlertThresholdMinutes" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" /><span>minutes</span></span></div>
    <div class="field-row field-row-indent"><label>Early Alert Threshold</label><span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.EarlyAlertThresholdMinutes" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" /><span>minutes</span></span></div>

    <div class="field-row"><label>Modify Stops</label></div>
    <div class="field-row field-row-indent"><label>Require Planned Route</label><ForgeRadioGroup @bind-Value="_model.ModifyStopsRequirePlannedRoute"><ForgeRadio Value="@true">Enabled</ForgeRadio><ForgeRadio Value="@false">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Allow During Navigation</label><ForgeRadioGroup @bind-Value="_model.ModifyStopsAllowDuringNavigation"><ForgeRadio Value="@true">Enabled</ForgeRadio><ForgeRadio Value="@false">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Enable Add By Address</label><ForgeRadioGroup @bind-Value="_model.ModifyStopsEnableAddByAddress"><ForgeRadio Value="@true">Enabled</ForgeRadio><ForgeRadio Value="@false">Disabled</ForgeRadio></ForgeRadioGroup></div>

    <div class="field-row"><label>Additional Stop Buffer</label></div>
    <div class="field-row field-row-indent"><label>All Stops</label><ForgeRadioGroup @bind-Value="_model.AdditionalStopBufferAllStops"><ForgeRadio Value="@true">Enabled</ForgeRadio><ForgeRadio Value="@false">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Before Stop</label><span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.AdditionalStopBufferBeforeFeet" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" /><span>feet</span></span></div>
    <div class="field-row field-row-indent"><label>After Stop</label><span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.AdditionalStopBufferAfterFeet" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" /><span>feet</span></span></div>
    <div class="field-row field-row-indent"><label>From Road</label><span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.AdditionalStopBufferFromRoadFeet" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" /><span>feet</span></span></div>

    <div class="field-row"><label>Enable ETA System Notifications</label><ForgeRadioGroup @bind-Value="_model.EnableEtaSystemNotifications"><ForgeRadio Value="@true">Enabled</ForgeRadio><ForgeRadio Value="@false">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-note">ETA System Notifications are required for other parts of the system to work, such as My Ride K-12 ETA Notifications and Arrival Board</div>

    <div class="setup-actions"><StxButton Intent="StxButtonIntent.Save" OnClick="HandleSave" /></div>
</ForgeForm>

@code {
    private readonly NavigationSetupModel _model = new();
    private ForgeForm? _form;
    private async Task HandleSave() { await Task.CompletedTask; }
}

