<ForgeForm @ref="_form" Model="_model">
    <div class="field-row">
        <label>Field Inspections</label>
        <ForgeRadioGroup @bind-Value="_model.FieldInspectionsEnabled">
            <ForgeRadio Value="@true">Enabled</ForgeRadio>
            <ForgeRadio Value="@false">Disabled</ForgeRadio>
        </ForgeRadioGroup>
    </div>

    @if (_model.FieldInspectionsEnabled)
    {
        <div class="field-row field-row-indent"><ForgeCheckbox @bind-Value="_model.SignatureOnFail" Label="Signature On Fail" /></div>
        <div class="field-row field-row-indent"><ForgeCheckbox @bind-Value="_model.SignatureOnPass" Label="Signature On Pass" /></div>
        <div class="field-row field-row-indent"><ForgeCheckbox @bind-Value="_model.UpdateOdometer" Label="Update Odometer" /></div>
        <div class="field-row field-row-indent"><ForgeCheckbox @bind-Value="_model.SingleDefectSelection" Label="Single Defect Selection" /></div>
        <div class="field-row field-row-indent"><ForgeCheckbox @bind-Value="_model.EnableWorkOrderVerification" Label="Enable Work Order Verification" /></div>
        <div class="field-row field-row-indent"><ForgeCheckbox @bind-Value="_model.HideVehiclesWithOpenWorkOrders" Label="Hide Vehicles With Open Work Orders" /></div>
    }

    <div class="field-row">
        <label>Notes On Fail</label>
        <ForgeSelect @bind-Value="_model.NotesOnFail" FloatLabelType="FloatLabelType.Never" style="width:160px">
            <ForgeSelectOption Value="@("Off")">Off</ForgeSelectOption>
            <ForgeSelectOption Value="@("Prompt")">Prompt</ForgeSelectOption>
            <ForgeSelectOption Value="@("Require")">Require</ForgeSelectOption>
        </ForgeSelect>
    </div>
    <div class="field-row">
        <label>Notes On Critical</label>
        <ForgeSelect @bind-Value="_model.NotesOnCritical" FloatLabelType="FloatLabelType.Never" style="width:160px">
            <ForgeSelectOption Value="@("Off")">Off</ForgeSelectOption>
            <ForgeSelectOption Value="@("Prompt")">Prompt</ForgeSelectOption>
            <ForgeSelectOption Value="@("Require")">Require</ForgeSelectOption>
        </ForgeSelect>
    </div>
    <div class="field-row">
        <label>Odometer Warning</label>
        <ForgeRadioGroup @bind-Value="_model.OdometerWarningEnabled">
            <ForgeRadio Value="@true">Enabled</ForgeRadio>
            <ForgeRadio Value="@false">Disabled</ForgeRadio>
        </ForgeRadioGroup>
    </div>
    @if (_model.OdometerWarningEnabled)
    {
        <div class="field-row field-row-indent">
            <label>Warning Threshold</label>
            <span style="display:flex;align-items:center;gap:8px"><ForgeNumberField @bind-Value="_model.OdometerWarningThreshold" FloatLabelType="FloatLabelType.Never" Min="0" Max="100" style="width:80px" /><span>%</span></span>
        </div>
        <div class="field-row field-row-indent">
            <label>Minimum Units</label>
            <ForgeNumberField @bind-Value="_model.OdometerWarningMinimumUnits" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" />
        </div>
    }

    <div class="setup-actions"><StxButton Intent="StxButtonIntent.Save" OnClick="HandleSave" /></div>
</ForgeForm>

@code {
    private readonly InspectionsSetupModel _model = new();
    private ForgeForm? _form;
    private async Task HandleSave() { await Task.CompletedTask; }
}

