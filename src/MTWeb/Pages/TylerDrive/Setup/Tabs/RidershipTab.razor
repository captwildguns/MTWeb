<ForgeForm @ref="_form" Model="_model">
    <div class="field-row"><label>Student Ridership</label><ForgeRadioGroup Value="@ED(_model.StudentRidershipEnabled)" ValueChanged="@((string v) => _model.StudentRidershipEnabled = v == "Enabled")"><ForgeRadio Value="Enabled">Enabled</ForgeRadio><ForgeRadio Value="Disabled">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Flag Students on Wrong Run</label><ForgeRadioGroup Value="@ED(_model.FlagStudentsOnWrongRun)" ValueChanged="@((string v) => _model.FlagStudentsOnWrongRun = v == "Enabled")"><ForgeRadio Value="Enabled">Enabled</ForgeRadio><ForgeRadio Value="Disabled">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Flag Students at Wrong Stop</label><ForgeRadioGroup Value="@ED(_model.FlagStudentsAtWrongStop)" ValueChanged="@((string v) => _model.FlagStudentsAtWrongStop = v == "Enabled")"><ForgeRadio Value="Enabled">Enabled</ForgeRadio><ForgeRadio Value="Disabled">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Show Student Seating</label><ForgeRadioGroup Value="@ED(_model.ShowStudentSeating)" ValueChanged="@((string v) => _model.ShowStudentSeating = v == "Enabled")"><ForgeRadio Value="Enabled">Enabled</ForgeRadio><ForgeRadio Value="Disabled">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Show No Shows</label><ForgeRadioGroup Value="@ED(_model.ShowNoShows)" ValueChanged="@((string v) => _model.ShowNoShows = v == "Enabled")"><ForgeRadio Value="Enabled">Enabled</ForgeRadio><ForgeRadio Value="Disabled">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>DSR</label><ForgeRadioGroup Value="@ED(_model.DsrEnabled)" ValueChanged="@((string v) => _model.DsrEnabled = v == "Enabled")"><ForgeRadio Value="Enabled">Enabled</ForgeRadio><ForgeRadio Value="Disabled">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Enable QR Reader</label><ForgeRadioGroup Value="@ED(_model.EnableQrReader)" ValueChanged="@((string v) => _model.EnableQrReader = v == "Enabled")"><ForgeRadio Value="Enabled">Enabled</ForgeRadio><ForgeRadio Value="Disabled">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="field-row field-row-indent"><label>Custom Fields</label><ForgeTextField @bind-Value="_model.CustomFields" FloatLabelType="FloatLabelType.Never" style="width:220px" /></div>
    <div class="field-row"><label>Require Driver Acknowledgement of Visual Indicators</label><ForgeRadioGroup Value="@ED(_model.RequireDriverAcknowledgementOfVisualIndicators)" ValueChanged="@((string v) => _model.RequireDriverAcknowledgementOfVisualIndicators = v == "Enabled")"><ForgeRadio Value="Enabled">Enabled</ForgeRadio><ForgeRadio Value="Disabled">Disabled</ForgeRadio></ForgeRadioGroup></div>
    <div class="setup-actions"><StxButton Intent="StxButtonIntent.Save" OnClick="HandleSave" /></div>
</ForgeForm>
@code {
    private readonly RidershipSetupModel _model = new();
    private ForgeForm? _form;
    private static string ED(bool v) => v ? "Enabled" : "Disabled";
    private async Task HandleSave() { await Task.CompletedTask; }
}
