<ForgeForm @ref="_form" Model="_model">
    <div class="field-row"><label>Student Ridership</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.StudentRidershipEnabled)" ValueChanged="@((string v)=>_model.StudentRidershipEnabled=v=="Enabled")" RadioValue="Enabled" Name="sr">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.StudentRidershipEnabled)" ValueChanged="@((string v)=>_model.StudentRidershipEnabled=v=="Enabled")" RadioValue="Disabled" Name="sr">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Flag Students on Wrong Run</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.FlagStudentsOnWrongRun)" ValueChanged="@((string v)=>_model.FlagStudentsOnWrongRun=v=="Enabled")" RadioValue="Enabled" Name="fsWR">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.FlagStudentsOnWrongRun)" ValueChanged="@((string v)=>_model.FlagStudentsOnWrongRun=v=="Enabled")" RadioValue="Disabled" Name="fsWR">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Flag Students at Wrong Stop</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.FlagStudentsAtWrongStop)" ValueChanged="@((string v)=>_model.FlagStudentsAtWrongStop=v=="Enabled")" RadioValue="Enabled" Name="fsWS">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.FlagStudentsAtWrongStop)" ValueChanged="@((string v)=>_model.FlagStudentsAtWrongStop=v=="Enabled")" RadioValue="Disabled" Name="fsWS">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Show Student Seating</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.ShowStudentSeating)" ValueChanged="@((string v)=>_model.ShowStudentSeating=v=="Enabled")" RadioValue="Enabled" Name="ssSeat">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.ShowStudentSeating)" ValueChanged="@((string v)=>_model.ShowStudentSeating=v=="Enabled")" RadioValue="Disabled" Name="ssSeat">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Show No Shows</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.ShowNoShows)" ValueChanged="@((string v)=>_model.ShowNoShows=v=="Enabled")" RadioValue="Enabled" Name="noShow">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.ShowNoShows)" ValueChanged="@((string v)=>_model.ShowNoShows=v=="Enabled")" RadioValue="Disabled" Name="noShow">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>DSR</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.DsrEnabled)" ValueChanged="@((string v)=>_model.DsrEnabled=v=="Enabled")" RadioValue="Enabled" Name="dsr">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.DsrEnabled)" ValueChanged="@((string v)=>_model.DsrEnabled=v=="Enabled")" RadioValue="Disabled" Name="dsr">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Enable QR Reader</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.EnableQrReader)" ValueChanged="@((string v)=>_model.EnableQrReader=v=="Enabled")" RadioValue="Enabled" Name="qr">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.EnableQrReader)" ValueChanged="@((string v)=>_model.EnableQrReader=v=="Enabled")" RadioValue="Disabled" Name="qr">Disabled</ForgeRadio></span></div>
    <div class="field-row field-row-indent"><label>Custom Fields</label><ForgeTextField @bind-Value="_model.CustomFields" FloatLabelType="FloatLabelType.Never" style="width:220px" /></div>
    <div class="field-row"><label>Require Driver Acknowledgement of Visual Indicators</label><span style="display:flex;gap:16px"><ForgeRadio Value="@ED(_model.RequireDriverAcknowledgementOfVisualIndicators)" ValueChanged="@((string v)=>_model.RequireDriverAcknowledgementOfVisualIndicators=v=="Enabled")" RadioValue="Enabled" Name="rdAck">Enabled</ForgeRadio><ForgeRadio Value="@ED(_model.RequireDriverAcknowledgementOfVisualIndicators)" ValueChanged="@((string v)=>_model.RequireDriverAcknowledgementOfVisualIndicators=v=="Enabled")" RadioValue="Disabled" Name="rdAck">Disabled</ForgeRadio></span></div>
    <div class="setup-actions"><StxButton Intent="StxButtonIntent.Save" OnClick="HandleSave" /></div>
</ForgeForm>
@code {
    private readonly RidershipSetupModel _model = new();
    private ForgeForm? _form;
    private static string ED(bool v) => v ? "Enabled" : "Disabled";
    private async Task HandleSave() { await Task.CompletedTask; }
}
