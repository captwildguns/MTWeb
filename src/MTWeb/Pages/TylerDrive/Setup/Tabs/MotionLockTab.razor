@using MTWeb.Pages.TylerDrive.Setup.Tabs

<ForgeForm @ref="_form" Model="_model">
    <div class="setup-section">
        <ForgeText Typography="Typography.Heading6" class="mb-small">Distracted Driver Mode</ForgeText>

        <ForgeRadioGroup @bind-Value="_model.DistractedDriverMode">
            <div class="field-row">
                <label>All Screens in Motion</label>
                <ForgeRadio Value="@("AllScreens")">All Screens</ForgeRadio>
            </div>
            <div class="field-row">
                <label>Navigation Only in Motion</label>
                <ForgeRadio Value="@("NavigationOnly")">Navigation Only</ForgeRadio>
            </div>
            <div class="field-row">
                <label>At Student Stop</label>
                <ForgeRadio Value="@("StudentStop")">Student Stop</ForgeRadio>
            </div>
            <div class="field-row">
                <label>At Location Stop</label>
                <ForgeRadio Value="@("LocationStop")">Location Stop</ForgeRadio>
            </div>
        </ForgeRadioGroup>
    </div>

    <div class="setup-section">
        <ForgeText Typography="Typography.Heading6" class="mb-small">Display Elements</ForgeText>

        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.ShowClock" /><span>Clock</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.ShowDate" /><span>Date</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.ShowNextDirection" /><span>Next Direction</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.ShowNextDirectionArrow" /><span>Next Direction Arrow</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.ShowNextDirectionDistance" /><span>Next Direction Distance</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.ShowNextStopTime" /><span>Next Stop Time</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.ShowNextStopAddress" /><span>Next Stop Address</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.ShowNextStopPickupDropoff" /><span>Next Stop Pickup / Dropoff</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.ShowStudentsOnBus" /><span>Students on Bus</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.ShowStudentScans" /><span>Student Scans</span></label></div>

        @if (_model.ShowStudentScans)
        {
            <div class="field-row field-row-indent"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.StudentScanAudibleAlert" /><span>Student Scan Audible Alert</span></label></div>
        }
    </div>

    <div class="setup-section">
        <ForgeText Typography="Typography.Heading6" class="mb-small">Navigation Features</ForgeText>

        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.AudibleDirections" /><span>Audible Directions</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.EarlyDisengage" /><span>Early Disengage</span></label></div>

        @if (_model.EarlyDisengage)
        {
            <div class="field-row field-row-indent">
                <label>Early Disengage Distance (ft)</label>
                <ForgeNumberField @bind-Value="_model.EarlyDisengageDistance" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" />
            </div>
            <div class="field-row field-row-indent"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.EarlyDisengageKeepOff" /><span>Keep Early Disengage Off</span></label></div>
        }
    </div>

    <div class="setup-actions">
        <StxButton Intent="StxButtonIntent.Save" OnClick="HandleSave" />
    </div>
</ForgeForm>

@code {
    private readonly MotionLockSetupModel _model = new();
    private ForgeForm? _form;

    private async Task HandleSave()
    {
        // TODO: POST to /TylerDrive/Setup/UpdateMotionLockConfig
        await Task.CompletedTask;
    }
}
