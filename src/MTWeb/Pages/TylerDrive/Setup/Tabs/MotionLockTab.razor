@using MTWeb.Pages.TylerDrive.Setup.Tabs

<ForgeForm @ref="_form" Model="_model">
    <div class="setup-section">
        <ForgeText Typography="Typography.Heading6" class="mb-small">Distracted Driver Mode</ForgeText>

        <ForgeRadioGroup @bind-Value="_model.DistractedDriverMode">
            <div class="field-row">
                <label>All Screens in Motion</label>
                <ForgeRadio Value="@("AllScreens")">All Screens</ForgeRadio>
            </div>
            <div class="field-row">
                <label>Navigation Only in Motion</label>
                <ForgeRadio Value="@("NavigationOnly")">Navigation Only</ForgeRadio>
            </div>
            <div class="field-row">
                <label>At Student Stop</label>
                <ForgeRadio Value="@("StudentStop")">Student Stop</ForgeRadio>
            </div>
            <div class="field-row">
                <label>At Location Stop</label>
                <ForgeRadio Value="@("LocationStop")">Location Stop</ForgeRadio>
            </div>
        </ForgeRadioGroup>
    </div>

    <div class="setup-section">
        <ForgeText Typography="Typography.Heading6" class="mb-small">Display Elements</ForgeText>

        <div class="field-row"><label>Clock</label><ForgeSwitch @bind-Value="_model.ShowClock" Label="Show" /></div>
        <div class="field-row"><label>Date</label><ForgeSwitch @bind-Value="_model.ShowDate" Label="Show" /></div>
        <div class="field-row"><label>Next Direction</label><ForgeSwitch @bind-Value="_model.ShowNextDirection" Label="Show" /></div>
        <div class="field-row"><label>Next Direction Arrow</label><ForgeSwitch @bind-Value="_model.ShowNextDirectionArrow" Label="Show" /></div>
        <div class="field-row"><label>Next Direction Distance</label><ForgeSwitch @bind-Value="_model.ShowNextDirectionDistance" Label="Show" /></div>
        <div class="field-row"><label>Next Stop Time</label><ForgeSwitch @bind-Value="_model.ShowNextStopTime" Label="Show" /></div>
        <div class="field-row"><label>Next Stop Address</label><ForgeSwitch @bind-Value="_model.ShowNextStopAddress" Label="Show" /></div>
        <div class="field-row"><label>Next Stop Pickup / Dropoff</label><ForgeSwitch @bind-Value="_model.ShowNextStopPickupDropoff" Label="Show" /></div>
        <div class="field-row"><label>Students on Bus</label><ForgeSwitch @bind-Value="_model.ShowStudentsOnBus" Label="Show" /></div>
        <div class="field-row"><label>Student Scans</label><ForgeSwitch @bind-Value="_model.ShowStudentScans" Label="Show" /></div>

        @if (_model.ShowStudentScans)
        {
            <div class="field-row">
                <label>Student Scan Audible Alert</label>
                <ForgeSwitch @bind-Value="_model.StudentScanAudibleAlert" Label="Enable" />
            </div>
        }
    </div>

    <div class="setup-section">
        <ForgeText Typography="Typography.Heading6" class="mb-small">Navigation Features</ForgeText>

        <div class="field-row">
            <label>Audible Directions</label>
            <ForgeSwitch @bind-Value="_model.AudibleDirections" Label="Enable" />
        </div>
        <div class="field-row">
            <label>Early Disengage</label>
            <ForgeSwitch @bind-Value="_model.EarlyDisengage" Label="Enable" />
        </div>

        @if (_model.EarlyDisengage)
        {
            <div class="field-row">
                <label>Early Disengage Distance (ft)</label>
                <ForgeNumberField @bind-Value="_model.EarlyDisengageDistance"
                                  Label="Feet"
                                  Min="0"
                                  FloatLabelType="FloatLabelType.Always" />
            </div>
            <div class="field-row">
                <label>Keep Early Disengage Off</label>
                <ForgeSwitch @bind-Value="_model.EarlyDisengageKeepOff" Label="Keep Off" />
            </div>
        }
    </div>

    <div class="setup-actions">
        <StxButton Intent="StxButtonIntent.Save" OnClick="HandleSave" />
    </div>
</ForgeForm>

@code {
    private readonly MotionLockSetupModel _model = new();
    private ForgeForm? _form;

    private async Task HandleSave()
    {
        // TODO: POST to /TylerDrive/Setup/UpdateMotionLockConfig
        await Task.CompletedTask;
    }
}



