@using MTWeb.Pages.TylerDrive.Setup.Tabs

<ForgeForm @ref="_form" Model="_model">
    <div class="setup-section">
        <ForgeText Typography="Typography.Heading6" class="mb-small">Cellular Data</ForgeText>

        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.AllowCellularForFeedback" /><span>Allow Cellular for Feedback</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.AllowCellularForGlobalUsage" /><span>Allow Cellular for Global Usage</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.AllowCellularForNewsAndUpdates" /><span>Allow Cellular for News &amp; Updates</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.AllowCellularForMapDownloads" /><span>Allow Cellular for Map Downloads</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.AllowCellularForSearch" /><span>Allow Cellular for Search</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.AllowCellularForTrafficServices" /><span>Allow Cellular for Traffic Services</span></label></div>
    </div>

    <div class="setup-section">
        <ForgeText Typography="Typography.Heading6" class="mb-small">Navigation Display</ForgeText>

        <div class="field-row">
            <label>Approaching Stop Distance (ft)</label>
            <ForgeNumberField @bind-Value="_model.ApproachingStopDistance" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" />
        </div>
        <div class="field-row">
            <label>Chevron Display</label>
            <ForgeSelect @bind-Value="_model.ChevronDisplay" FloatLabelType="FloatLabelType.Never" style="width:200px">
                <ForgeSelectOption Value="@("Both")">Both</ForgeSelectOption>
                <ForgeSelectOption Value="@("TurnOnly")">Turn Only</ForgeSelectOption>
                <ForgeSelectOption Value="@("None")">None</ForgeSelectOption>
            </ForgeSelect>
        </div>
        <div class="field-row">
            <label>Flow Traffic Availability</label>
            <ForgeSelect @bind-Value="_model.FlowTrafficAvailability" FloatLabelType="FloatLabelType.Never" style="width:200px">
                <ForgeSelectOption Value="@("Automatic")">Automatic</ForgeSelectOption>
                <ForgeSelectOption Value="@("Always")">Always</ForgeSelectOption>
                <ForgeSelectOption Value="@("Never")">Never</ForgeSelectOption>
            </ForgeSelect>
        </div>
        <div class="field-row">
            <label>Stop Side Display</label>
            <ForgeSelect @bind-Value="_model.StopSideDisplay" FloatLabelType="FloatLabelType.Never" style="width:200px">
                <ForgeSelectOption Value="@("Auto")">Auto</ForgeSelectOption>
                <ForgeSelectOption Value="@("Left")">Left</ForgeSelectOption>
                <ForgeSelectOption Value="@("Right")">Right</ForgeSelectOption>
            </ForgeSelect>
        </div>
        <div class="field-row">
            <label>Traffic Bar Visibility</label>
            <ForgeSelect @bind-Value="_model.TrafficBarVisibility" FloatLabelType="FloatLabelType.Never" style="width:200px">
                <ForgeSelectOption Value="@("Automatic")">Automatic</ForgeSelectOption>
                <ForgeSelectOption Value="@("Always")">Always</ForgeSelectOption>
                <ForgeSelectOption Value="@("Never")">Never</ForgeSelectOption>
            </ForgeSelect>
        </div>
    </div>

    <div class="setup-section">
        <ForgeText Typography="Typography.Heading6" class="mb-small">Audio &amp; Spoken Feedback</ForgeText>

        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.PlayWelcome" /><span>Play Welcome</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.SayWelcome" /><span>Say Welcome</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.AudibleDirections" /><span>Audible Directions</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.SpeakCalculatingRoute" /><span>Speak Calculating Route</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.SetSpeedAlertAudio" /><span>Speed Alert Audio</span></label></div>
    </div>

    <div class="setup-section">
        <ForgeText Typography="Typography.Heading6" class="mb-small">Navigation Messages</ForgeText>

        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.ShowArrivalPopup" /><span>Show Arrival Popup</span></label></div>
        <div class="field-row">
            <label>Message Display at Stop</label>
            <ForgeSelect @bind-Value="_model.NavMessageAtStop" FloatLabelType="FloatLabelType.Never" style="width:200px">
                <ForgeSelectOption Value="@("Always")">Always</ForgeSelectOption>
                <ForgeSelectOption Value="@("OnError")">On Error</ForgeSelectOption>
                <ForgeSelectOption Value="@("Never")">Never</ForgeSelectOption>
            </ForgeSelect>
        </div>
        <div class="field-row">
            <label>Message Display in Motion</label>
            <ForgeSelect @bind-Value="_model.NavMessageInMotion" FloatLabelType="FloatLabelType.Never" style="width:200px">
                <ForgeSelectOption Value="@("Always")">Always</ForgeSelectOption>
                <ForgeSelectOption Value="@("OnError")">On Error</ForgeSelectOption>
                <ForgeSelectOption Value="@("Never")">Never</ForgeSelectOption>
            </ForgeSelect>
        </div>
    </div>

    <div class="setup-section">
        <ForgeText Typography="Typography.Heading6" class="mb-small">Turn Warnings</ForgeText>

        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.EnableEarlyTurnWarning" /><span>Enable Early Turn Warning</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.EnableFarTurnWarning" /><span>Enable Far Turn Warning</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.EnableNearTurnWarning" /><span>Enable Near Turn Warning</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.EnableTurnRestrictions" /><span>Enable Turn Restrictions</span></label></div>
        <div class="field-row"><label style="display:flex;align-items:center;gap:8px;cursor:pointer"><ForgeCheckbox @bind-Value="_model.ShowTurnAfterNext" /><span>Show Turn After Next</span></label></div>
    </div>

    <div class="setup-section">
        <ForgeText Typography="Typography.Heading6" class="mb-small">Map Display</ForgeText>

        <div class="field-row">
            <label>Map View at Stop</label>
            <ForgeSelect @bind-Value="_model.NavMapViewAtStop" FloatLabelType="FloatLabelType.Never" style="width:200px">
                <ForgeSelectOption Value="@("Overview")">Overview</ForgeSelectOption>
                <ForgeSelectOption Value="@("Turn")">Turn</ForgeSelectOption>
                <ForgeSelectOption Value="@("Street")">Street</ForgeSelectOption>
            </ForgeSelect>
        </div>
        <div class="field-row">
            <label>Map View in Motion</label>
            <ForgeSelect @bind-Value="_model.NavMapViewInMotion" FloatLabelType="FloatLabelType.Never" style="width:200px">
                <ForgeSelectOption Value="@("Overview")">Overview</ForgeSelectOption>
                <ForgeSelectOption Value="@("Turn")">Turn</ForgeSelectOption>
                <ForgeSelectOption Value="@("Street")">Street</ForgeSelectOption>
            </ForgeSelect>
        </div>
        <div class="field-row">
            <label>Map Update Interval (ms)</label>
            <ForgeNumberField @bind-Value="_model.MapUpdateIntervalMs" FloatLabelType="FloatLabelType.Never" Min="100" style="width:80px" />
        </div>
    </div>

    <div class="setup-section">
        <ForgeText Typography="Typography.Heading6" class="mb-small">Info Bar</ForgeText>

        <div class="field-row">
            <label>Info Bar Left</label>
            <ForgeSelect @bind-Value="_model.InfoBarLeft" FloatLabelType="FloatLabelType.Never" style="width:200px">
                <ForgeSelectOption Value="@("Speed")">Speed</ForgeSelectOption>
                <ForgeSelectOption Value="@("ETA")">ETA</ForgeSelectOption>
                <ForgeSelectOption Value="@("Distance")">Distance</ForgeSelectOption>
                <ForgeSelectOption Value="@("None")">None</ForgeSelectOption>
            </ForgeSelect>
        </div>
        <div class="field-row">
            <label>Info Bar Right</label>
            <ForgeSelect @bind-Value="_model.InfoBarRight" FloatLabelType="FloatLabelType.Never" style="width:200px">
                <ForgeSelectOption Value="@("Speed")">Speed</ForgeSelectOption>
                <ForgeSelectOption Value="@("ETA")">ETA</ForgeSelectOption>
                <ForgeSelectOption Value="@("Distance")">Distance</ForgeSelectOption>
                <ForgeSelectOption Value="@("None")">None</ForgeSelectOption>
            </ForgeSelect>
        </div>
    </div>

    <div class="setup-actions">
        <StxButton Intent="StxButtonIntent.Save" OnClick="HandleSave" />
    </div>
</ForgeForm>

@code {
    private readonly AlkSetupModel _model = new();
    private ForgeForm? _form;

    private async Task HandleSave()
    {
        // TODO: POST to /TylerDrive/Setup/UpdateAlkConfig
        await Task.CompletedTask;
    }
}
