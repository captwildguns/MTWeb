<ForgeForm @ref="_form" Model="_model">
    <div class="field-row">
        <label>Timekeeping</label>
        <ForgeRadioGroup @bind-Value="_timekeeping">
            <ForgeRadio Value="Enabled">Enabled</ForgeRadio>
            <ForgeRadio Value="Disabled">Disabled</ForgeRadio>
        </ForgeRadioGroup>
    </div>
    @if (_model.TimekeepingEnabled)
    {
        <div class="field-row-indent" style="padding-top:4px">
            <ForgeCheckbox @bind-Value="_model.MandatoryPunchIn">Mandatory Punch In</ForgeCheckbox>
        </div>
        <div class="field-row field-row-indent">
            <label>Clock In Buffer</label>
            <span style="display:flex;align-items:center;gap:8px">
                <ForgeNumberField @bind-Value="_model.ClockInBufferMinutes" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" />
                <span>minutes</span>
            </span>
        </div>
        <div class="field-row field-row-indent">
            <label>Clock Out Buffer</label>
            <span style="display:flex;align-items:center;gap:8px">
                <ForgeNumberField @bind-Value="_model.ClockOutBufferMinutes" FloatLabelType="FloatLabelType.Never" Min="0" style="width:80px" />
                <span>minutes</span>
            </span>
        </div>
        <div class="field-row field-row-indent">
            <label>Break Time</label>
            <ForgeSelect @bind-Value="_model.BreakTime" FloatLabelType="FloatLabelType.Never" style="width:160px">
                <ForgeSelectOption Value="@("Off")">Off</ForgeSelectOption>
                <ForgeSelectOption Value="@("On")">On</ForgeSelectOption>
            </ForgeSelect>
        </div>
    }
    <div class="setup-actions"><StxButton Intent="StxButtonIntent.Save" OnClick="HandleSave" /></div>
</ForgeForm>

@code {
    private readonly TimeTrackingSetupModel _model = new()
    {
        TimekeepingEnabled = true,
        ClockInBufferMinutes = 15,
        ClockOutBufferMinutes = 15,
        BreakTime = "Off"
    };
    private ForgeForm? _form;

    private string _timekeeping
    {
        get => _model.TimekeepingEnabled ? "Enabled" : "Disabled";
        set => _model.TimekeepingEnabled = value == "Enabled";
    }

    private async Task HandleSave() { await Task.CompletedTask; }
}
